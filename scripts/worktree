#!/bin/sh
# Creates and removes a ticket's worktree next to the main checkout (`../lil.tech-<number>`), with
# the build data Xcode keeps for it outside the worktree, so none is left behind (851-2884).
# Usage:
#   scripts/worktree new <ticket-number> <branch>
#       Adds `../lil.tech-<number>` on a new branch from a freshly fetched origin/main (or on the
#       branch, if it already exists), then warms it: resolves the Swift package, installs the
#       TypeScript workspace, and checks the generated API client. Run again, it only warms.
#       The package is resolved into `LilPackage/.build`, which `scripts/swift build`,
#       `scripts/swift test` and `scripts/snapshot` use (`scripts/check` resolves its `.build-check`
#       when it first runs). They compile with the cache every worktree shares
#       (`scripts/compilation-cache`, 851-3235), so a new worktree's first build replays what
#       another already compiled.
#       A new worktree's `.build` starts as a copy (APFS clones, `cp -c`) of the last one's, kept
#       in `~/Library/Caches/lil.tech/worktree-package`, so resolving it fetches only what changed,
#       rather than every dependency (851-2973). It resolves holding
#       `/tmp/lil-package-resolve.lock`, so two at once don't share that copy.
#   scripts/worktree remove <ticket-number> [--stash]
#       Refuses while the worktree has uncommitted changes, unless `--stash` stashes them (in the
#       main repo, with a message naming the ticket). Deletes its Xcode DerivedData and removes
#       the worktree. Deletes its branch when nothing on it would be lost: it's in origin/main, or
#       its PR is merged or closed (or its remote branch is gone) and the branch is still at the
#       PR's last commit.
#   scripts/worktree prune [--apply]
#       Lists every `lil.tech-*` worktree with its PR's state and whether it has uncommitted
#       changes, and Xcode DerivedData left by worktrees that no longer exist. `--apply` removes
#       the worktrees whose PR is merged or closed and that have no uncommitted changes, and
#       deletes that DerivedData. Never touches the main checkout.
# A ticket number is `2884` or `851-2884`.
# A worktree's DerivedData is found by its `info.plist`, or by the folder's name, which Xcode derives
# from the path of the workspace, project or package it's for. A workspace that never finished
# loading leaves a folder without an `info.plist`.
set -eu

usage() {
  echo "usage: scripts/worktree new <ticket-number> <branch>" >&2
  echo "       scripts/worktree remove <ticket-number> [--stash]" >&2
  echo "       scripts/worktree prune [--apply]" >&2
  exit 2
}

# The main checkout, wherever this runs from (it may be a worktree's copy of the script).
main=$(cd "$(dirname "$0")" && git rev-parse --path-format=absolute --git-common-dir)
main=$(dirname "$main")
cd "$main"
# Worktrees are `<main>-<number>`: `lil.tech-2884` next to `lil.tech`.
prefix="$main-"
derived_data="$HOME/Library/Developer/Xcode/DerivedData"
# Lists of paths below are split on newlines only, so paths with spaces survive.
newline='
'
IFS=$newline

number() {
  n=${1#851-}
  case "$n" in
    '' | *[!0-9]*)
      echo "error: '$1' isn't a ticket number, like 2884 or 851-2884." >&2
      exit 2
      ;;
  esac
  echo "$n"
}

fetch() {
  git fetch -q --prune origin ||
    echo "warning: couldn't fetch origin, so branches are judged by what was last fetched." >&2
}

is_worktree() {
  git worktree list --porcelain | grep -qxF "worktree $1"
}

# The branch checked out in a worktree, empty when it's detached or not a worktree.
worktree_branch() {
  git worktree list --porcelain | awk -v path="$1" '
    $1 == "worktree" { current = substr($0, 10) }
    $1 == "branch" && current == path { sub("refs/heads/", "", $2); print $2 }'
}

# The state of the branch's latest PR (MERGED, CLOSED or OPEN) and its last commit, as
# "<state> <sha>"; "NONE" without a PR, or "UNKNOWN" if GitHub can't be asked.
pr_info() {
  gh pr list --head "$1" --state all --limit 1 --json state,headRefOid \
    --jq '.[0] // {state: "NONE", headRefOid: ""} | "\(.state) \(.headRefOid)"' 2>/dev/null ||
    echo UNKNOWN
}

# The workspace or project an Xcode DerivedData folder was built for.
workspace_path() {
  [ -f "$1/info.plist" ] || return 0
  plutil -extract WorkspacePath raw -o - "$1/info.plist" 2>/dev/null || true
}

# The workspaces, projects and packages Xcode can open in a checkout, relative to it: each
# `*.xcworkspace`, `*.xcodeproj` and folder with a `Package.swift` in the main checkout.
containers() {
  git ls-files -- '*/Package.swift' '*.xcodeproj/project.pbxproj' \
    '*.xcworkspace/contents.xcworkspacedata' |
    sed -n -e 's|/Package\.swift$||p' -e 's|/project\.pbxproj$||p' \
      -e 's|/contents\.xcworkspacedata$||p' |
    grep -v '\.xcodeproj/' || true
}

# Xcode names the DerivedData folder of a workspace, project or package `<name>-<hash>`: its name
# without the extension, and the MD5 of its path in 28 letters (each half of the digest, as a
# big-endian number, in 14 base-26 digits from a to z). Xcode writes the folder's `info.plist` only
# once the workspace has loaded its packages, so the name is all that ties one that never finished
# loading to its folder (851-2940).
#   derived_data_hashes hash <path>...
#       Prints the hash of each path.
#   derived_data_hashes find <prefix> <containers> <dir>...
#       For each DerivedData folder named after `<prefix><number>/<container>`, for a number up to
#       99999 and one of the newline-separated containers, prints "<number> <dir>". Other folders
#       are left out.
derived_data_hashes() {
  python3 -I - "$@" <<'PY'
import hashlib
import os
import sys


def name_hash(path):
    digest = hashlib.md5(path.encode()).digest()
    letters = ""
    for half in (digest[:8], digest[8:]):
        value = int.from_bytes(half, "big")
        chunk = ""
        for _ in range(14):
            value, digit = divmod(value, 26)
            chunk = chr(ord("a") + digit) + chunk
        letters += chunk
    return letters


mode, args = sys.argv[1], sys.argv[2:]
if mode == "hash":
    for path in args:
        print(name_hash(path))
else:
    prefix, containers, dirs = args[0], args[1].split("\n"), args[2:]
    # A folder is only checked against the containers its name starts with.
    wanted = {}
    for d in dirs:
        name, _, digest = os.path.basename(d).rpartition("-")
        for container in containers:
            if container and os.path.splitext(os.path.basename(container))[0] == name:
                wanted.setdefault(container, {})[digest] = d
    found = set()
    for number in range(1, 100000):
        for container, folders in list(wanted.items()):
            d = folders.pop(name_hash(f"{prefix}{number}/{container}"), None)
            if d and d not in found:
                found.add(d)
                print(number, d)
            if not folders:
                del wanted[container]
        if not wanted:
            break
PY
}

# Deletes the DerivedData of worktree `$1` (a path): folders whose `info.plist` names a workspace,
# project or package in it, or whose name is one's, as Xcode derives it from its path.
delete_derived_data() {
  paths=""
  for container in $(containers); do
    paths="$paths$1/$container$newline"
  done
  if ! hashes=$(derived_data_hashes hash $paths); then
    echo "warning: couldn't work out Xcode's folder names (python3 failed), so build data" \
      "without an info.plist is kept." >&2
    hashes=""
  fi
  for dir in "$derived_data"/*/; do
    dir=${dir%/}
    match=false
    case "$(workspace_path "$dir")" in
      "$1"/*) match=true ;;
    esac
    for hash in $hashes; do
      case "$dir" in
        *-"$hash") match=true ;;
      esac
    done
    $match || continue
    echo "Deleting Xcode's build data for it: $dir ($(du -sh "$dir" | cut -f1))"
    rm -rf "$dir"
  done
}

delete_branch_if_done() {
  branch=$1
  git show-ref --verify --quiet "refs/heads/$branch" || return 0
  tip=$(git rev-parse "refs/heads/$branch")
  info=$(pr_info "$branch")
  state=${info%% *}
  head=${info#* }
  reason=""
  if git merge-base --is-ancestor "$tip" origin/main; then
    reason="it's in origin/main"
  elif [ "$tip" = "$head" ]; then
    # Squash merges aren't ancestors of main, so a finished PR's branch is judged by its PR: if
    # the branch is still at the PR's last commit, GitHub has everything on it.
    case "$state" in
      MERGED) reason="its PR is merged" ;;
      CLOSED) reason="its PR is closed" ;;
    esac
  fi
  if [ -z "$reason" ]; then
    echo "Keeping branch $branch: it isn't merged, or has commits its PR doesn't."
  elif git branch -D "$branch" >/dev/null 2>&1; then
    echo "Deleted branch $branch (was $(git rev-parse --short "$tip")), since $reason."
  else
    echo "Keeping branch $branch: it's checked out somewhere else."
  fi
}

# The lock `new` resolves holding, so two of them don't use the kept copy below at once: a
# directory, made with `mkdir`. Builds and tests don't take it. Named in 851-3061; its old name,
# from when agents also held it while Xcode opened a workspace, went in 851-3069.
resolve_lock=/tmp/lil-package-resolve.lock
holding_lock=false

take_resolve_lock() {
  trap '! $holding_lock || rmdir "$resolve_lock" 2>/dev/null || true' EXIT
  trap 'exit 1' HUP INT TERM
  waited=0
  until mkdir "$resolve_lock" 2>/dev/null; do
    since=$(stat -f %Sm "$resolve_lock" 2>/dev/null || true)
    if [ "$waited" -ge 1200 ]; then
      echo "error: waited 20 minutes for $resolve_lock (held since $since). If nothing holds" \
        "it, remove it and run this again." >&2
      exit 1
    fi
    if [ $((waited % 60)) -eq 0 ]; then
      echo "Waiting for $resolve_lock (held since $since), which another worktree's" \
        "resolution holds…"
    fi
    sleep 5
    waited=$((waited + 5))
  done
  holding_lock=true
}

# Releases the lock once, ignoring signals meanwhile, so an interrupted release neither leaves it
# behind nor removes it again once another run may have taken it.
release_resolve_lock() {
  trap '' HUP INT TERM
  rmdir "$resolve_lock" 2>/dev/null || true
  holding_lock=false
  trap - EXIT HUP INT TERM
}

# What a SwiftPM scratch directory holds of the dependencies: its clones of their repositories,
# their working copies, binary artifacts, prebuilt macro libraries, and its record of them.
scratch_items="repositories${newline}checkouts${newline}artifacts${newline}prebuilts"
scratch_items="$scratch_items${newline}workspace-state.json"
# A copy of the dependencies of the last new worktree's `.build`, which the next one starts from,
# with the `Package.resolved` it was resolved for, copied last, so a copy without it is
# unfinished. Used only holding the lock.
package_seed="$HOME/Library/Caches/lil.tech/worktree-package"

# Copies scratch directory `$1`'s dependencies into `$2`, which has none, as APFS clones, which
# are quick and share disk space until they change. Only reads `$1`.
seed_scratch() {
  mkdir -p "$2" || return 1
  for item in $scratch_items; do
    if [ -e "$1/$item" ]; then
      cp -cRp "$1/$item" "$2/" || return 1
    fi
  done
  # The working copies and SwiftPM's record name their scratch directory, so they would still use
  # `$1`'s clones. Working copies are read-only.
  for file in "$2"/checkouts/*/.git/config "$2"/checkouts/*/.git/objects/info/alternates \
    "$2/workspace-state.json"; do
    [ -f "$file" ] || continue
    mode=$(stat -f %Lp "$file") || return 1
    chmod u+w "$file" || return 1
    FROM=$1 TO=$2 perl -pi -e 's|\Q$ENV{FROM}\E/|$ENV{TO}/|g' "$file" || return 1
    chmod "$mode" "$file" || return 1
  done
}

# Whether scratch directory `$1` stands on its own and matches SwiftPM's record of it: every path
# in the record, and every working copy's clone, is inside it, and every working copy is at its
# recorded revision, unchanged. SwiftPM trusts its record, so a working copy left half-updated, or
# still using another directory's clone, would otherwise go unnoticed until a build broke.
scratch_is_sound() {
  python3 -I - "$1" <<'PY'
import json
import os
import re
import subprocess
import sys

root = sys.argv[1]


def fail(message):
    print(f"{root}: {message}", file=sys.stderr)
    sys.exit(1)


def absolute_paths(value):
    if isinstance(value, dict):
        value = list(value.values())
    if isinstance(value, list):
        for item in value:
            yield from absolute_paths(item)
    elif isinstance(value, str) and value.startswith("/"):
        yield value


def inside(path, folder):
    return path.strip().startswith(f"{root}/{folder}")


with open(f"{root}/workspace-state.json") as file:
    state = json.load(file)
for path in absolute_paths(state):
    if not inside(path, ""):
        fail(f"its record names {path}.")
for dependency in state["object"]["dependencies"]:
    revision = dependency["state"].get("checkoutState", {}).get("revision")
    if revision is None:
        continue
    name = dependency["subpath"]
    checkout = f"{root}/checkouts/{name}"
    alternates = f"{checkout}/.git/objects/info/alternates"
    if os.path.exists(alternates):
        with open(alternates) as file:
            if not all(inside(line, "repositories/") for line in file if line.strip()):
                fail(f"{name}'s working copy uses another directory's clone.")
    with open(f"{checkout}/.git/config") as file:
        origin = re.search(r'\[remote "origin"\][^\[]*?\burl = (.*)', file.read())
    if not origin or not inside(origin.group(1), "repositories/"):
        fail(f"{name}'s working copy comes from another directory's clone.")
    # Clones keep their files' times but not their inodes, which would make Git read every file.
    status = subprocess.run(
        ["git", "-C", checkout, "-c", "core.checkStat=minimal"]
        + ["status", "--porcelain=v2", "--branch"],
        capture_output=True,
        text=True,
    )
    lines = status.stdout.splitlines()
    head = next((line.split()[2] for line in lines if line.startswith("# branch.oid ")), None)
    changed = any(not line.startswith("#") for line in lines)
    if status.returncode or head != revision or changed:
        fail(f"{name}'s working copy isn't at {revision}, unchanged.")
PY
}

# Resolves the package in the current directory into scratch directory `$1`. A new one starts as a
# copy of the kept one, so only what changed since is fetched, then is kept in its place, unless
# that's for the same `Package.resolved`. If what's resolved doesn't stand on its own
# (`scratch_is_sound`), say because a run was interrupted, its dependencies are deleted and
# resolved from nothing.
resolve_package() {
  new_scratch=false
  seeded=false
  if [ ! -e "$1/workspace-state.json" ] && [ ! -e "$1/checkouts" ] &&
    [ ! -e "$1/repositories" ]; then
    new_scratch=true
    [ ! -f "$package_seed/Package.resolved" ] || seeded=true
  fi
  replace_seed=false
  if { ! $seeded || seed_scratch "$package_seed" "$1"; } &&
    swift package resolve --scratch-path "$1" >/dev/null && scratch_is_sound "$1"; then
    :
  else
    echo "warning: $1 didn't resolve cleanly, so its dependencies are resolved from nothing." >&2
    for item in $scratch_items; do
      rm -rf "${1:?}/$item"
    done
    swift package resolve --scratch-path "$1" >/dev/null
    replace_seed=$seeded
  fi
  if $replace_seed ||
    { $new_scratch && ! cmp -s Package.resolved "$package_seed/Package.resolved"; }; then
    rm -rf "$package_seed"
    if ! { seed_scratch "$1" "$package_seed" && scratch_is_sound "$package_seed" &&
      cp Package.resolved "$package_seed/"; }; then
      echo "warning: couldn't keep a copy of $1 for the next worktree in $package_seed." >&2
      rm -rf "$package_seed"
    fi
  fi
}

cmd_new() {
  [ $# -eq 2 ] || usage
  n=$(number "$1")
  branch=$2
  path="$prefix$n"
  if is_worktree "$path"; then
    echo "$path already exists, so this only warms it."
  elif [ -e "$path" ]; then
    echo "error: $path already exists, and isn't one of this repo's worktrees." >&2
    exit 1
  else
    fetch
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$path" "$branch"
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git worktree add --track -b "$branch" "$path" "origin/$branch"
    else
      # No upstream yet: the first `git push -u origin HEAD` sets it to the branch's own.
      git worktree add --no-track -b "$branch" "$path" origin/main
    fi
  fi
  cd "$path/LilPackage"
  echo "Resolving the Swift package…"
  take_resolve_lock
  resolve_package "$PWD/.build"
  release_resolve_lock
  cd "$path"
  echo "Installing the TypeScript workspace…"
  vp install --frozen-lockfile --silent
  if ! output=$(scripts/generate-api-client --check 2>&1); then
    echo "$output" >&2
    exit 1
  fi
  echo "Ready: $path"
}

# Removes worktree `$1` (a path), stashing its changes first if `$2` is true. Fetch first.
remove_worktree() {
  path=$1
  stash=$2
  n=${path#"$prefix"}
  branch=$(worktree_branch "$path")
  if [ -d "$path" ]; then
    if ! is_worktree "$path"; then
      echo "error: $path isn't one of this repo's worktrees." >&2
      exit 1
    fi
    if [ -n "$(git -C "$path" status --porcelain --untracked-files=all)" ]; then
      if ! $stash; then
        echo "error: $path has uncommitted changes. Commit them, or stash them with --stash:" >&2
        git -C "$path" status --short >&2
        exit 1
      fi
      git -C "$path" stash push -q -u -m "851-$n leftover: scripts/worktree remove --stash"
      echo "Stashed its changes in the main repo: $(git stash list -n 1)"
    fi
  else
    echo "$path is already gone."
  fi
  # Xcode's build data lives outside the worktree, so removing the worktree leaves it behind.
  delete_derived_data "$path"
  if [ -d "$path" ]; then
    # Clean, as checked above, apart from ignored files: builds and node_modules.
    git worktree remove --force "$path"
    echo "Removed $path"
  fi
  git worktree prune
  if [ -z "$branch" ]; then
    # `gh pr merge --delete-branch` can remove the worktree first, so look the branch up by name.
    branch=$(git for-each-ref --format='%(refname:short)' refs/heads |
      grep -E -m 1 "(^|/)851-$n-" || true)
  fi
  if [ -n "$branch" ]; then
    delete_branch_if_done "$branch"
  fi
}

cmd_remove() {
  [ $# -ge 1 ] || usage
  n=$(number "$1")
  shift
  stash=false
  for arg in "$@"; do
    case "$arg" in
      --stash) stash=true ;;
      *) usage ;;
    esac
  done
  fetch
  remove_worktree "$prefix$n" "$stash"
}

cmd_prune() {
  apply=false
  for arg in "$@"; do
    case "$arg" in
      --apply) apply=true ;;
      *) usage ;;
    esac
  done
  git worktree prune
  removable=""
  found=false
  for path in $(git worktree list --porcelain | sed -n 's/^worktree //p'); do
    case "$path" in
      "$prefix"*) ;;
      *) continue ;;
    esac
    found=true
    branch=$(worktree_branch "$path")
    if [ -n "$branch" ]; then
      info=$(pr_info "$branch")
      state=${info%% *}
    else
      branch="(detached)"
      state=NONE
    fi
    case "$state" in
      MERGED) pr="PR merged" ;;
      CLOSED) pr="PR closed" ;;
      OPEN) pr="PR open" ;;
      NONE) pr="no PR" ;;
      *) pr="PR unknown (gh failed)" ;;
    esac
    if [ -n "$(git -C "$path" status --porcelain --untracked-files=all)" ]; then
      changes="uncommitted changes"
    else
      changes="clean"
    fi
    echo "$(basename "$path")  $branch  $pr, $changes"
    case "$state,$changes" in
      MERGED,clean | CLOSED,clean) removable="$removable$path$newline" ;;
    esac
  done
  $found || echo "No $(basename "$main")-* worktrees."

  # DerivedData built for a worktree that no longer exists: by its `info.plist`, or, without one,
  # by its name.
  stale=""
  unloaded=""
  for dir in "$derived_data"/*/; do
    dir=${dir%/}
    if [ ! -f "$dir/info.plist" ]; then
      unloaded="$unloaded$dir$newline"
      continue
    fi
    workspace=$(workspace_path "$dir")
    case "$workspace" in
      "$prefix"*) ;;
      *) continue ;;
    esac
    root=${workspace#"$prefix"}
    root="$prefix${root%%/*}"
    [ -d "$root" ] && continue
    echo "Xcode build data for $(basename "$root"), which is gone: $dir ($(du -sh "$dir" | cut -f1))"
    stale="$stale$dir$newline"
  done
  if [ -n "$unloaded" ]; then
    if matches=$(derived_data_hashes find "$prefix" "$(containers)" $unloaded); then
      for match in $matches; do
        root="$prefix${match%% *}"
        dir=${match#* }
        [ -d "$root" ] && continue
        echo "Xcode build data for $(basename "$root"), which is gone (it never finished" \
          "loading): $dir ($(du -sh "$dir" | cut -f1))"
        stale="$stale$dir$newline"
      done
    else
      echo "warning: couldn't match Xcode build data without an info.plist to worktrees" \
        "(python3 failed)." >&2
    fi
  fi

  if ! $apply; then
    if [ -n "$removable$stale" ]; then
      echo "Run 'scripts/worktree prune --apply' to remove the merged or closed, clean worktrees" \
        "and the build data of worktrees that are gone."
    fi
    return 0
  fi
  [ -z "$removable" ] || fetch
  for path in $removable; do
    echo "== $(basename "$path")"
    remove_worktree "$path" false
  done
  for dir in $stale; do
    echo "Deleting $dir"
    rm -rf "$dir"
  done
}

[ $# -ge 1 ] || usage
command=$1
shift
case "$command" in
  new) cmd_new "$@" ;;
  remove) cmd_remove "$@" ;;
  prune) cmd_prune "$@" ;;
  *) usage ;;
esac
