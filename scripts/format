#!/bin/sh
# Formats every Swift file with swift-format, and the TypeScript workspace (Services/, Web/)
# with Vite+ (Oxfmt), and regenerates the server's copy of the Health catalog, the server's card
# files (the card spec's schema, the welcome seed and the validation cases), the API's OpenAPI
# spec, its MCP tool definitions and the Swift client.
# Usage: scripts/format [--lint] [--swift | --services]
#   --lint   Check without changing files: swift-format lint, a check that
#            Services/api/health-catalog.json and the card files are up to date
#            (scripts/generate-health-cards), and one that no Swift code has a
#            `#Preview` or `PreviewProvider` (851-2970), plus `vp check`
#            (format, lint and type check) for the workspace, plus a check that
#            Services/api/openapi.json, Services/api/mcp-tools.json, the core D1
#            migrations and the generated Swift client are up to date. Runs every check
#            and exits non-zero if any fails.
#   --swift     Only the Swift part, with the Health catalog and card files.
#   --services  Only the TypeScript workspace, with the spec, tools and client.
set -u

lint=false
swift_only=false
services_only=false
for arg in "$@"; do
  case "$arg" in
    --lint) lint=true ;;
    --swift) swift_only=true ;;
    --services) services_only=true ;;
    *)
      echo "usage: scripts/format [--lint] [--swift | --services]" >&2
      exit 2
      ;;
  esac
done

cd "$(dirname "$0")/.."

# Generated files are left as their generators write them: the Swift client, and the MCP tool
# definitions (Services/api/scripts/mcp-tools.ts), whose JSON swift-format would indent.
files=$(find . -name '*.swift' \
  -not -path '*/.build/*' \
  -not -path './.build-check/*' \
  -not -path './build/*' \
  -not -path '*/DerivedData/*' \
  -not -path '*/.swiftpm/*' \
  -not -path '*/node_modules/*' \
  -not -path './LilPackage/Sources/Lil/LilAPIGenerated/*' \
  -not -path './LilPackage/Sources/Health/HealthCLI/MCPToolsJSON.swift')

status=0

# shellcheck disable=SC2086
if $services_only; then
  :
elif $lint; then
  xcrun swift-format lint --strict --parallel $files || status=1
  scripts/generate-health-catalog --check || status=1
  scripts/generate-health-cards --check || status=1
  # UI states are state catalogs (AGENTS.md › UI states). A preview would also run the live
  # dependencies, since none has a `previewValue` any more: real iMessages, the API, the Keychain.
  if git grep -n -E '#Preview|PreviewProvider' -- '*.swift'; then
    echo "error: SwiftUI previews above. Show those states in a state catalog instead" \
      "(AGENTS.md › UI states)." >&2
    status=1
  fi
else
  xcrun swift-format format --in-place --parallel $files || status=1
  # The server's copy of the Health catalog, generated from the Swift one (851-2857).
  scripts/generate-health-catalog || status=1
  # The server's card files, generated from HealthCards (851-3194).
  scripts/generate-health-cards || status=1
fi

if $swift_only; then
  exit "$status"
fi

if ! command -v vp >/dev/null 2>&1; then
  echo "error: vp (Vite+) is required for the TypeScript workspace. Install it with 'brew install vite-plus'." >&2
  exit 1
fi

# The workspace moved from Services/ to the root (851-2683). A clone from before keeps a stale
# Services/node_modules that Node would still search from Services/api, so it goes.
if [ -d Services/node_modules ]; then
  rm -rf Services/node_modules
fi

# Keeps node_modules in sync with the lockfile; fast when nothing changed.
if ! vp install --frozen-lockfile --silent; then
  exit 1
fi

# The committed OpenAPI spec is generated from the API definition, and the Swift client from the
# spec, in that order.
if $lint; then
  vp check || status=1
  (cd Services/api && node scripts/openapi.ts --check) || status=1
  (cd Services/api && node scripts/mcp-tools.ts --check) || status=1
  (cd Services/api && node scripts/migrations.ts --check) || status=1
  scripts/generate-api-client --check-stamp || status=1
else
  vp fmt || status=1
  (cd Services/api && node scripts/openapi.ts) || status=1
  (cd Services/api && node scripts/mcp-tools.ts) || status=1
  (cd Services/api && node scripts/migrations.ts) || status=1
  scripts/generate-api-client || status=1
fi

exit "$status"
