#!/bin/sh
# Formats every Swift file with swift-format, and the TypeScript in Services/
# with Vite+ (Oxfmt), and regenerates the API's OpenAPI spec.
# Usage: scripts/format [--lint]
#   --lint  Check without changing files: swift-format lint, plus `vp check`
#           (format, lint and type check) for Services/, plus a check that
#           Services/api/openapi.json is up to date. Runs every check and exits
#           non-zero if any fails.
set -u

cd "$(dirname "$0")/.."

files=$(find . -name '*.swift' \
  -not -path '*/.build/*' \
  -not -path '*/DerivedData/*' \
  -not -path '*/.swiftpm/*' \
  -not -path '*/node_modules/*')

status=0

# shellcheck disable=SC2086
if [ "${1:-}" = "--lint" ]; then
  xcrun swift-format lint --strict --parallel $files || status=1
else
  xcrun swift-format format --in-place --parallel $files || status=1
fi

if ! command -v vp >/dev/null 2>&1; then
  echo "error: vp (Vite+) is required for Services/. Install it with 'brew install vite-plus'." >&2
  exit 1
fi

# Keeps Services/node_modules in sync with the lockfile; fast when nothing changed.
if ! (cd Services && vp install --frozen-lockfile --silent); then
  exit 1
fi

# The committed OpenAPI spec is generated from the API definition.
if [ "${1:-}" = "--lint" ]; then
  (cd Services && vp check) || status=1
  (cd Services/api && node scripts/openapi.ts --check) || status=1
else
  (cd Services && vp fmt) || status=1
  (cd Services/api && node scripts/openapi.ts) || status=1
fi

exit "$status"
