#!/bin/bash
# Pixelbook (851-2696): publishes the state catalogs' images, and renders SwiftUI previews.
# Usage: scripts/pixelbook publish [--commit <sha>] [--ref <name> [--force-ref]] [--dry-run]
#          scripts/pixelbook key [commit]
#          scripts/pixelbook render [out-dir]
#          scripts/pixelbook check
#   publish  Uploads a commit's state catalog images to Pixelbook's bucket
#            (Services/api/scripts/pixelbook.ts), unless a commit with the same catalogs already
#            did, and points the commit and the ref (the current branch by default; none with
#            --commit) at them (851-2955). The images are the catalogs' committed references, with
#            a manifest per screen that their snapshot tests write, so it reads them from the
#            commit with git: no Xcode, simulator or render, and uncommitted changes don't count.
#            CI publishes every PR's head and base, and every merge to main (pr.yml, main.yml).
#            --force-ref: move the ref even if that takes it back to an older commit.
#   key      Prints the key a commit's snapshots are published under (HEAD by default).
#   render   Renders every #Preview to PNGs, light and dark, with SnapshotPreviews, into out-dir,
#            as <app>/<light|dark>/ (default build/pixelbook/<commit>). It's replaced, so it must
#            be new, empty, or under build/. Nothing publishes renders any more; it goes with
#            SnapshotPreviews in 851-2969.
#   check    Renders twice and fails if any image's pixels differ, or if a preview reported an
#            issue (851-2698).
# Rendering: Tools/PixelbookSnapshots has a test target per app (lil health on Mac and iPhone, lil
# messages): the Mac's run on their own, the iPhone's in an empty host app, since iOS previews need
# a running app. Each PNG has a JSON sidecar (module, file, preview name, line).
# Mac previews that fill a window (a split view, a navigation title or toolbar items) are captured
# from a titled window with ScreenCaptureKit, so Xcode needs Screen Recording access once; without
# it, or when a capture fails (a locked screen), render exits 1 and says why.
# PIXELBOOK_STRICT=1 makes render exit 2 when a preview reports an issue, instead of warning.
# PIXELBOOK_SIMULATOR picks the iPhone simulator (default "iPhone 18 Pro"); images take its size.
# PIXELBOOK_PREVIEWS renders only some previews, for trying a change: comma-separated regular
# expressions matched against each preview's Module/File.swift:Name (e.g. AppViewPreviews.swift).
# Previews render with preview dependencies, as in Xcode (SWIFT_DEPENDENCIES_CONTEXT). Not with
# XCODE_RUNNING_FOR_PREVIEWS, which switches SwiftUI into its preview layout and changes sizes.
# SnapshotPreviews fixes the clock (gettimeofday) at August 13, 2024, 07:00 UTC, so previews
# that use the current date render the same every day. The time zone is fixed too (TZ), so day
# boundaries don't move with the machine or daylight saving time.
set -euo pipefail

command=${1:-}
if [ "$command" != "render" ] && [ "$command" != "check" ] && [ "$command" != "publish" ] &&
  [ "$command" != "key" ]; then
  echo "usage: scripts/pixelbook render [out-dir] | check | publish [options] | key [commit]" >&2
  exit 64
fi
caller=$PWD
cd "$(dirname "$0")/.."
root=$PWD
project="$root/Tools/PixelbookSnapshots/PixelbookSnapshots.xcodeproj"

# Previews render against the library versions the apps use: LilPackage's pins, plus
# SnapshotPreviews' own. `sync_pins --check` only says (exit 1) whether they differ.
sync_pins() {
  local resolved="$project/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
  python3 -I - "$root/LilPackage/Package.resolved" "$resolved" "${1:-}" <<'PY'
import json, sys
lil = {pin["identity"]: pin for pin in json.load(open(sys.argv[1]))["pins"]}
path = sys.argv[2]
ours = json.load(open(path))
pins = [lil.get(pin["identity"], pin) for pin in ours["pins"]]
if pins != ours["pins"]:
    if sys.argv[3] == "--check":
        sys.exit(1)
    ours["pins"] = pins
    with open(path, "w") as file:
        # Xcode's own layout, so only changed pins show in a diff.
        json.dump(ours, file, indent=2, separators=(",", " : "))
        file.write("\n")
PY
}

# What a commit's snapshots come from: every test target's state catalogs (their sources,
# references and manifests), and the scripts that publish them.
key_of() {
  {
    git ls-tree -r -d "$1" -- LilPackage/Tests |
      awk -F'\t' '$2 ~ /^LilPackage\/Tests\/[^\/]+\/Catalogs$/'
    local input
    for input in scripts/pixelbook Services/api/scripts/pixelbook.ts Services/api/scripts/png.ts; do
      git rev-parse -q --verify "$1:$input" 2>/dev/null || echo "missing $input"
    done
  } | shasum -a 256 | cut -c1-16
}

if [ "$command" = "key" ]; then
  key_of "$(git rev-parse "${2:-HEAD}^{commit}")"
  exit 0
fi

if [ "$command" = "publish" ]; then
  shift
  ref=$(git symbolic-ref --short -q HEAD || true)
  ref_given=false
  target=HEAD
  options=()
  while [ $# -gt 0 ]; do
    case $1 in
      --ref) ref=${2:?--ref needs a name}; ref_given=true; shift 2 ;;
      --commit) target=${2:?--commit needs a commit}; shift 2 ;;
      --force-ref) options+=(--force-ref); shift ;;
      --dry-run) options+=(--dry-run); shift ;;
      *) echo "Unknown option $1" >&2; exit 64 ;;
    esac
  done
  # Another commit isn't the checked-out branch's.
  [ "$target" != HEAD ] && ! $ref_given && ref=""
  commit=$(git rev-parse "$target^{commit}")
  key=$(key_of "$commit")
  [ -n "$ref" ] && options+=(--ref "$ref")
  cd Services/api
  exec node scripts/pixelbook.ts --key "$key" --commit "$commit" ${options[@]+"${options[@]}"}
fi

if [ "$command" = "check" ]; then
  first="$root/build/pixelbook/check-1"
  second="$root/build/pixelbook/check-2"
  # Strict: a preview that reports an issue fails the render (exit 2), so the second run is skipped.
  for run in "$first" "$second"; do
    if ! PIXELBOOK_STRICT=1 "$root/scripts/pixelbook" render "$run"; then
      echo "Rendering into $run failed or a preview reported an issue; see its .log files." >&2
      exit 1
    fi
  done
  # The same images both times…
  images() { (cd "$1" && find . -name '*.png' | sort); }
  if ! diff <(images "$first") <(images "$second") >&2; then
    echo "The two runs rendered different sets of images (< first, > second)." >&2
    exit 1
  fi
  # …with the same pixels. Not bytes: PNG metadata differs between runs, and BMP has none.
  bitmaps=$(mktemp -d)
  trap 'rm -rf "$bitmaps"' EXIT
  differ=0
  while IFS= read -r relative; do
    sips -s format bmp "$first/$relative" --out "$bitmaps/a.bmp" >/dev/null
    sips -s format bmp "$second/$relative" --out "$bitmaps/b.bmp" >/dev/null
    if ! cmp -s "$bitmaps/a.bmp" "$bitmaps/b.bmp"; then
      echo "Differs: $relative" >&2
      differ=$((differ + 1))
    fi
  done < <(images "$first")
  total=$(images "$first" | wc -l | tr -d ' ')
  if [ "$differ" -gt 0 ]; then
    echo "$differ of $total images differ between two runs." >&2
    exit 1
  fi
  echo "==> All $total images render the same twice."
  exit 0
fi
# One render at a time on a Mac (851-2805): the simulator is shared, so another render installing
# its test host kills this one's runs, and two Mac test runs at once hang. The render runs again
# holding a lock that the kernel lets go of when it ends, however it ends; another waits, for 30
# minutes at most (then it fails, which the pre-push hook skips on).
lock="/tmp/pixelbook-render-$(id -u).lock"
if [ -z "${PIXELBOOK_RENDER_LOCKED:-}" ]; then
  lockf -s -t 0 "$lock" true 2>/dev/null || echo "==> Waiting for another render on this Mac to finish"
  # From where it was started, so a relative folder means the same.
  cd "$caller"
  PIXELBOOK_RENDER_LOCKED=1 exec lockf -k -t 1800 "$lock" "$root/scripts/pixelbook" "$@"
fi
out=${2:-$root/build/pixelbook/$(git rev-parse --short HEAD)}
[[ "$out" = /* ]] || out="$caller/$out"
if [ -e "$out" ] && [[ "$out" != "$root/build/"* ]] && [ -n "$(ls -A "$out" 2>/dev/null)" ]; then
  echo "$out isn't empty: pick a new directory, or one under build/." >&2
  exit 64
fi
derived="$root/build/pixelbook/DerivedData"
simulator=${PIXELBOOK_SIMULATOR:-iPhone 18 Pro}
mac="platform=macOS,arch=$(uname -m)"

device=$(xcrun simctl list devices available | grep -m1 "    $simulator (" | grep -oE '[0-9A-F-]{36}' || true)
if [ -z "$device" ]; then
  echo "No \"$simulator\" simulator: create one in Xcode, or set PIXELBOOK_SIMULATOR." >&2
  exit 1
fi

rm -rf "$out"
mkdir -p "$out"

sync_pins

echo "==> Resolving packages"
xcodebuild -resolvePackageDependencies -project "$project" -scheme HealthMacSnapshots \
  -derivedDataPath "$derived" -onlyUsePackageVersionsFromResolvedFile -quiet

# Our SnapshotPreviews fork signs PreviewsSupport.framework's macOS slice, whose signature upstream
# is broken (github.com/getsentry/SnapshotPreviews/issues/236): macOS refuses to load it, and may
# move it to the Trash as malware. Checked here, so a fork update that brings the broken one back
# says so rather than failing to load. That's the pinned code's fault, not the machine's, so it
# exits 2, which blocks a push as a preview's issue does.
framework="$derived/SourcePackages/checkouts/SnapshotPreviews/PreviewsSupport/PreviewsSupport.xcframework/macos-arm64_x86_64/PreviewsSupport.framework"
if [ ! -d "$framework" ]; then
  echo "SnapshotPreviews has no macOS PreviewsSupport.framework at $framework." >&2
  echo "Did the fork's layout change? Update the path here." >&2
  exit 2
fi
if ! verified=$(codesign --verify --strict "$framework" 2>&1); then
  echo "$verified" >&2
  echo "SnapshotPreviews' macOS PreviewsSupport.framework isn't signed properly." >&2
  echo "Sign it ad hoc in the fork (codesign --force --sign -) and tag a new version." >&2
  exit 2
fi

echo "==> Building for macOS and the iPhone simulator"
for scheme in HealthMacSnapshots MessagesMacSnapshots; do
  xcodebuild build-for-testing -project "$project" -scheme "$scheme" -destination "$mac" \
    -derivedDataPath "$derived" -onlyUsePackageVersionsFromResolvedFile -skipMacroValidation -quiet
done
xcodebuild build-for-testing -project "$project" -scheme HealthPhoneSnapshots \
  -destination "id=$device" -derivedDataPath "$derived" -onlyUsePackageVersionsFromResolvedFile \
  -skipMacroValidation -quiet

# Mac previews that fill a window are captured with ScreenCaptureKit (our fork of SnapshotPreviews,
# 851-2711), which needs Xcode to have Screen Recording access: the test runner is Xcode's. A capture
# that fails is the machine's doing (no access, a locked screen), so render stops with exit 1, which
# the pre-push hook skips on, rather than reporting the previews.
capture_failed() {
  grep -qE "SCStreamErrorDomain Code=-3801|screenCaptureFailed" "$1"
}
check_window_captures() {
  local log=$1
  if grep -q "SCStreamErrorDomain Code=-3801" "$log"; then
    echo "Xcode needs Screen Recording access to capture Mac previews that fill a window. Turn it" >&2
    echo "on in System Settings › Privacy & Security › Screen & System Audio Recording (add Xcode" >&2
    echo "with + if it isn't listed), then render again." >&2
    exit 1
  fi
  if capture_failed "$log"; then
    echo "Couldn't capture some Mac previews' windows (is the screen locked or asleep?); see $log." >&2
    exit 1
  fi
  # SnapshotPreviews tries a capture whose stream failed to start again, and logs it (851-2769).
  local retries
  retries=$(grep -c "stream failed to start (-3811); trying again" "$log" || true)
  if [ "$retries" -gt 0 ]; then
    echo "Note: $retries window captures had to be tried again (ScreenCaptureKit -3811); see $log." >&2
  fi
}

# run <app> <appearance> <xcodebuild arguments…>: one app's previews into $out/<app>/<appearance>,
# with the test run's log and exit status next to the folder.
run() {
  local app=$1 appearance=$2
  shift 2
  local dir="$out/$app/$appearance"
  mkdir -p "$dir"
  echo "==> Rendering $app ($appearance)"
  local status=0
  TEST_RUNNER_SNAPSHOTS_EXPORT_DIR="$dir" \
    TEST_RUNNER_PIXELBOOK=1 \
    TEST_RUNNER_PIXELBOOK_APPEARANCE="$appearance" \
    TEST_RUNNER_SWIFT_DEPENDENCIES_CONTEXT=preview \
    TEST_RUNNER_TZ=America/Los_Angeles \
    TEST_RUNNER_PIXELBOOK_PREVIEWS="${PIXELBOOK_PREVIEWS:-}" \
    xcodebuild test-without-building -project "$project" "$@" -derivedDataPath "$derived" \
    -collect-test-diagnostics never -quiet >"$dir.log" 2>&1 || status=$?
  echo "$status" >"$dir.status"
}

# The runs, as <app>:<scheme>, each in light and dark.
mac_apps=(health-mac:HealthMacSnapshots messages-mac:MessagesMacSnapshots)
iphone_apps=(health-iphone:HealthPhoneSnapshots)

# The Mac's runs and the iPhone's go side by side (851-2749): the iPhone's run in the simulator,
# apart from the screen the Mac's windows are captured on. Within each, runs go one after another:
# two Mac test runs at once hang, and the iPhone's appearance is the simulator's, for every app on
# it. Each lane exits 1 if one of its runs couldn't start, and 2 if a window capture failed.
mac_runs() {
  local appearance entry
  for appearance in light dark; do
    for entry in "${mac_apps[@]}"; do
      run "${entry%%:*}" "$appearance" -scheme "${entry#*:}" -destination "$mac" || return 1
      # It would fail the rest too.
      capture_failed "$out/${entry%%:*}/$appearance.log" && return 2
    done
  done
  return 0
}
# The simulator's test runner sometimes never connects: it times out preparing, or hangs
# (851-2805), with nothing rendered. Such a run is tried again, twice at most, in a simulator
# started afresh, keeping each failed try's log. A test host that crashes at launch isn't: that's
# the code's doing.
runner_started() {
  ! grep -qE "hung before establishing connection|timed out while preparing to run tests" "$1"
}
restart_simulator() {
  xcrun simctl shutdown "$device" 2>/dev/null || true
  xcrun simctl boot "$device" 2>/dev/null || true
  xcrun simctl bootstatus "$device" -b >/dev/null && xcrun simctl ui "$device" appearance "$1"
}
iphone_runs() {
  local appearance entry try
  for appearance in light dark; do
    xcrun simctl ui "$device" appearance "$appearance" || return 1
    for entry in "${iphone_apps[@]}"; do
      for try in 1 2 3; do
        run "${entry%%:*}" "$appearance" -scheme "${entry#*:}" -destination "id=$device" || return 1
        runner_started "$out/${entry%%:*}/$appearance.log" && break
        cp "$out/${entry%%:*}/$appearance.log" "$out/${entry%%:*}/$appearance.try$try.log"
        if [ "$try" -lt 3 ]; then
          echo "    ${entry%%:*}/$appearance: the test runner didn't start; trying again" >&2
          restart_simulator "$appearance" || return 1
        fi
      done
    done
  done
  return 0
}

# The simulator is shared with everyday use, so its appearance is put back afterwards, once
# nothing is changing it. Interrupted, the lanes and their test runs stop too.
xcrun simctl boot "$device" 2>/dev/null || true
xcrun simctl bootstatus "$device" -b >/dev/null
original=$(xcrun simctl ui "$device" appearance)
lanes=()
stop_lanes() {
  local lane
  for lane in ${lanes[@]+"${lanes[@]}"}; do
    pkill -P "$lane" 2>/dev/null || true
    kill "$lane" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap 'stop_lanes; xcrun simctl ui "$device" appearance "$original" 2>/dev/null || true' EXIT
trap 'exit 130' INT TERM
mac_runs &
mac_lane=$!
iphone_runs &
iphone_lane=$!
lanes=("$mac_lane" "$iphone_lane")
mac_status=0
wait "$mac_lane" || mac_status=$?
# A failed window capture is the machine's: the iPhone's runs needn't finish to say so.
if [ "$mac_status" -eq 2 ]; then
  stop_lanes
else
  iphone_status=0
  wait "$iphone_lane" || iphone_status=$?
  if [ "$mac_status" -ne 0 ] || [ "$iphone_status" -ne 0 ]; then
    echo "A render couldn't start (the simulator, or xcodebuild); see the .log files in $out." >&2
    exit 1
  fi
fi
lanes=()

# A preview that reports an issue fails its test but still renders, so that's a warning; a run
# that renders nothing, or never ran, fails the script.
warnings=0
empty=0
total=0
for entry in "${mac_apps[@]}" "${iphone_apps[@]}"; do
  for appearance in light dark; do
    dir="$out/${entry%%:*}/$appearance"
    if [ ! -f "$dir.log" ]; then
      # The Mac's runs stop at a failed window capture, reported here.
      [ "$mac_status" -eq 2 ] && continue
      echo "    ${entry%%:*}/$appearance: didn't run" >&2
      empty=$((empty + 1))
      continue
    fi
    check_window_captures "$dir.log"
    count=$(find "$dir" -name '*.png' | wc -l | tr -d ' ')
    echo "    ${entry%%:*}/$appearance: $count images"
    total=$((total + count))
    [ "$(cat "$dir.status" 2>/dev/null || echo 1)" -eq 0 ] || warnings=$((warnings + 1))
    # With PIXELBOOK_PREVIEWS, an app may have none of them.
    [ "$count" -gt 0 ] || [ -n "${PIXELBOOK_PREVIEWS:-}" ] || empty=$((empty + 1))
  done
done

echo "==> $out"
if [ "$total" -eq 0 ]; then
  echo "Nothing rendered: does PIXELBOOK_PREVIEWS match any previews? See the .log files." >&2
  exit 1
fi
if [ "$empty" -gt 0 ]; then
  echo "$empty run(s) rendered nothing; see their .log files." >&2
  exit 1
fi
if [ "$warnings" -gt 0 ]; then
  echo "Some previews reported issues; see the .log file next to each folder." >&2
  [ "${PIXELBOOK_STRICT:-}" = 1 ] && exit 2
fi
