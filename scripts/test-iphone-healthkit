#!/bin/sh
# Runs the iPhone's HealthKit tests (`HealthKitPhoneTests`, 851-3199) in a simulator of their own:
# they write synthetic samples into its HealthKit and read them back through the iPhone's code,
# such as its card engine (`HealthKitCardEngine`).
#
# usage: scripts/test-iphone-healthkit [<test>…]
#
#   <test>  A suite, or a suite's test, e.g. `HealthKitCardsTests` or
#           `HealthKitCardsTests/aSampleAcrossMidnightIsShared`. Every test without one.
#
# - It makes a new iPhone simulator (`LIL_HEALTHKIT_DEVICE_TYPE`, default iPhone 18 Pro, on the
#   newest iOS installed), boots it while the tests build, and deletes it when it exits, however
#   it ends: an idle simulator runs about 130 processes. To run again and again in one, make it
#   yourself and pass its UDID in `LIL_HEALTHKIT_SIMULATOR`; it's left for you to delete.
# - `simctl privacy` can't grant Health, so a UI test (`GrantHealthAccess`) first turns on access
#   for the tests' host app (`HealthKitTestHost`) in the sheet, as a person would.
# - It builds with `scripts/xcodebuild` (`Lil.xcworkspace`, scheme `HealthKitPhoneTests`) into
#   `.build/DerivedData`, or `LIL_HEALTHKIT_DERIVED_DATA` (CI's, kept outside the checkout). Logs and the result bundle go to `LilPackage/.build/healthkit-tests/`.
# - The cards' conformance cases (`HealthKitConformanceTests`, 851-3201) need each of the dataset's
#   sources to be an app of its own, since HealthKit gives a sample the source of the app that
#   saves it. So it installs copies of the host with the bundle IDs `ConformanceSourceApps` names,
#   one per source, which `GrantHealthAccess` gives access too. After the other suites, whose tests
#   need HealthKit to hold only their own samples, each copy writes its source's samples
#   (`ConformanceWriter`), then the conformance suite runs on its own, and the copies delete them.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
output="$root/LilPackage/.build/healthkit-tests"
derived=${LIL_HEALTHKIT_DERIVED_DATA:-$root/.build/DerivedData}
device_type=${LIL_HEALTHKIT_DEVICE_TYPE:-com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro}

for argument in "$@"; do
  case "$argument" in
    -*)
      echo "usage: scripts/test-iphone-healthkit [<test>…]" >&2
      exit 64
      ;;
  esac
done

rm -rf "$output"
mkdir -p "$output"

device=${LIL_HEALTHKIT_SIMULATOR:-}
if [ -z "$device" ]; then
  device=$(xcrun simctl create "lil-healthkit-$$" "$device_type")
  echo "Made the simulator lil-healthkit-$$ ($device)."
  # Never left behind, booted or not.
  trap 'xcrun simctl shutdown "$device" >/dev/null 2>&1 || true
    xcrun simctl delete "$device" >/dev/null 2>&1 && echo "Deleted the simulator ($device)."' EXIT
  trap 'exit 130' INT TERM
fi

# While the build runs.
xcrun simctl bootstatus "$device" -b >"$output/boot.log" 2>&1 &
booting=$!

status=0
"$root/scripts/xcodebuild" build-for-testing \
  -workspace "$root/Lil.xcworkspace" -scheme HealthKitPhoneTests \
  -destination "id=$device" -derivedDataPath "$derived" \
  -skipMacroValidation -onlyUsePackageVersionsFromResolvedFile -quiet >"$output/build.log" 2>&1 ||
  status=$?
if [ "$status" != 0 ]; then
  grep -E "error:|BUILD FAILED|xcodebuild: error" "$output/build.log" | sort -u >&2 || true
  echo "error: the build failed. See $output/build.log." >&2
  exit 1
fi
if ! wait "$booting"; then
  tail -n 5 "$output/boot.log" >&2
  echo "error: the simulator didn't boot. See $output/boot.log." >&2
  exit 1
fi

# Which tests run: the conformance suite on its own, after the others.
conformance_suite=HealthKitConformanceTests
others=""
conformance=""
if [ $# = 0 ]; then
  others="-only-testing:HealthKitPhoneTests -skip-testing:HealthKitPhoneTests/$conformance_suite"
  conformance="-only-testing:HealthKitPhoneTests/$conformance_suite"
fi
for filter in "$@"; do
  # Swift Testing's identifiers: a test, `Suite/test`, is `Suite/test()`. Names have no spaces.
  case "$filter" in
    */*")") ;;
    */*) filter="$filter()" ;;
  esac
  case "$filter" in
    "$conformance_suite" | "$conformance_suite"/*)
      conformance="$conformance -only-testing:HealthKitPhoneTests/$filter"
      ;;
    *) others="$others -only-testing:HealthKitPhoneTests/$filter" ;;
  esac
done

xctestrun=$(find "$derived/Build/Products" -maxdepth 1 -name 'HealthKitPhoneTests_*.xctestrun' \
  -print0 | xargs -0 ls -t 2>/dev/null | head -n 1)
case "$xctestrun" in
  */HealthKitPhoneTests_*.xctestrun) ;;
  *)
    echo "error: the build made no HealthKitPhoneTests_*.xctestrun in $derived/Build/Products." >&2
    exit 1
    ;;
esac
# Screenshots rather than a screen recording: ending the recording holds up each run for 5
# minutes after its tests finish.
for target in HealthKitAuthorizationUITests HealthKitPhoneTests; do
  plutil -replace "$target.PreferredScreenCaptureFormat" -string screenshots "$xctestrun"
done

# test <name> <xcodebuild options…>: runs tests from the build, with a result bundle and log of
# that name.
test() {
  name=$1
  shift
  status=0
  xcodebuild test-without-building -xctestrun "$xctestrun" -destination "id=$device" \
    -resultBundlePath "$output/$name.xcresult" -collect-test-diagnostics never \
    -parallel-testing-enabled NO "$@" >"$output/$name.log" 2>&1 || status=$?
  grep -E "^(Test|✔|✘|􀢄|􁁛)|error:|passed|failed" "$output/$name.log" | grep -v "^Test session" || true
  if [ "$status" != 0 ]; then
    echo "error: $name failed. See $output/$name.log and $output/$name.xcresult." >&2
    exit 1
  fi
}

# The conformance source apps: a copy of the host for each of the dataset's sources (samples' and
# workouts', as `ConformanceSamples` reads them), with the next of `ConformanceSourceApps`' bundle
# IDs, installed beside it.
apps=""
if [ -n "$conformance" ]; then
  source_count=$(python3 -I - "$root/Services/api/test/health/cards/conformance/dataset.json" <<'EOF'
import json, os, sys

def batches(path):
    dataset = json.load(open(path))
    base = dataset.get("extends")
    return (batches(os.path.join(os.path.dirname(path), base)) if base else []) + dataset["batches"]

print(len({line["row"]["sourceBundleId"] for batch in batches(sys.argv[1]) for line in batch["lines"]
           if line["entity"] in ("health_sample", "health_workout") and line["op"] == "upsert"}))
EOF
  )
  host="$derived/Build/Products/Debug-iphonesimulator/HealthKitTestHost.app"
  host_id=tech.lil.healthkit-test-host
  mkdir -p "$output/sources"
  number=1
  while [ "$number" -le "$source_count" ]; do
    id=$(printf 'tech.lil.healthkit-source-%02d' "$number")
    copy="$output/sources/$id.app"
    cp -R "$host" "$copy"
    rm -rf "$copy/PlugIns"
    plutil -replace CFBundleIdentifier -string "$id" "$copy/Info.plist"
    # The simulator takes an app's identity, and so the source HealthKit gives its samples, from
    # the `application-identifier` its executable embeds (the build's simulated entitlements), not
    # from its Info.plist. The source apps' bundle IDs are as long as the host's, so it's replaced
    # in place.
    LC_ALL=C perl -0777 -pi -e "s/\\Q$host_id\\E/$id/g" "$copy/HealthKitTestHost"
    if [ "${#id}" != "${#host_id}" ] || ! grep -q "$id" "$copy/HealthKitTestHost"; then
      echo "error: couldn't make $id's entitlements from the host's." >&2
      exit 1
    fi
    codesign --force --sign - "$copy" 2>>"$output/sources.log"
    xcrun simctl install "$device" "$copy"
    apps="$apps $id"
    number=$((number + 1))
  done
  echo "Installed $source_count conformance source apps."
fi

# sources <write|delete>: has each source app write its part of the dataset, or delete it.
sources() {
  for id in $apps; do
    said=$(xcrun simctl launch --console-pty --terminate-running-process "$device" "$id" \
      "-$1Conformance" 2>&1 | tr -d '\r' | tee -a "$output/sources.log" | grep -E "^(Wrote|Deleted|error:)" || true)
    case "$said" in
      Wrote* | Deleted*) ;;
      *)
        echo "${said:-error: $id said nothing.} See $output/sources.log." >&2
        exit 1
        ;;
    esac
  done
}

# For `GrantHealthAccess` (xcodebuild passes `TEST_RUNNER_` variables to tests, without it).
export TEST_RUNNER_LIL_HEALTHKIT_SOURCE_APPS="${apps# }"
test grant -only-testing:HealthKitAuthorizationUITests
if [ -n "$others" ]; then
  # A simulator used before may still hold the source apps' samples.
  sources delete
  # shellcheck disable=SC2086
  test tests $others
fi
if [ -n "$conformance" ]; then
  sources write
  echo "The source apps wrote the conformance dataset."
  # shellcheck disable=SC2086
  test conformance $conformance
  sources delete
fi
echo "Passed."
