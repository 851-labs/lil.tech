#!/usr/bin/env swift
// Usage: scripts/contact-sheet <output.png> <columns> <image.png>...
// Lays images out in a grid, each labeled with its file name.
import AppKit

let args = CommandLine.arguments
let output = URL(fileURLWithPath: args[1])
let columns = Int(args[2])!
let images = args.dropFirst(3).map { path -> (String, NSBitmapImageRep) in
  let rep = NSBitmapImageRep(data: try! Data(contentsOf: URL(fileURLWithPath: path)))!
  let name = URL(fileURLWithPath: path).deletingPathExtension().lastPathComponent
  return (name, rep)
}
let cellWidth = images.map { $0.1.pixelsWide }.max()!
let cellHeight = images.map { $0.1.pixelsHigh }.max()!
let labelHeight = 60, gap = 24
let rows = (images.count + columns - 1) / columns
let width = columns * cellWidth + (columns + 1) * gap
let height = rows * (cellHeight + labelHeight) + (rows + 1) * gap
let canvas = NSBitmapImageRep(
  bitmapDataPlanes: nil, pixelsWide: width, pixelsHigh: height, bitsPerSample: 8,
  samplesPerPixel: 4, hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB,
  bytesPerRow: 0, bitsPerPixel: 0)!
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: canvas)
NSColor(white: 0.93, alpha: 1).setFill()
NSRect(x: 0, y: 0, width: width, height: height).fill()
for (index, (name, rep)) in images.enumerated() {
  let column = index % columns, row = index / columns
  let x = gap + column * (cellWidth + gap)
  let top = height - gap - row * (cellHeight + labelHeight + gap)
  (name as NSString).draw(
    at: NSPoint(x: x, y: top - labelHeight + 14),
    withAttributes: [.font: NSFont.boldSystemFont(ofSize: 32), .foregroundColor: NSColor.black])
  rep.draw(in: NSRect(x: x, y: top - labelHeight - rep.pixelsHigh, width: rep.pixelsWide, height: rep.pixelsHigh))
}
NSGraphicsContext.restoreGraphicsState()
try! canvas.representation(using: .png, properties: [:])!.write(to: output)
