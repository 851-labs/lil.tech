#!/bin/sh
# Runs our checks (`docs/DECISIONS.md`). The pre-commit hook (`lefthook.yml`) runs the services and
# Pixelbook parts a commit touches; GitHub runs the Swift and Pixelbook parts on our Mac minis
# (`swift-check.yml`), rendering snapshots without comparing them (`LIL_SNAPSHOT_RENDER_ONLY`).
# Usage: scripts/check [--hook] [--swift] [--services] [--pixelbook]   (every part when none is given)
#   --swift     Swift lint (with a check that the server's copy of the Health catalog is fresh),
#               `scripts/snapshot --sheet`'s check, the package's tests, and the apps' builds,
#               with the iPhone's snapshot tests'.
#   --services  Format, lint and type checks (`scripts/format --lint --services`, which also checks
#               the OpenAPI spec is fresh), the generated Swift client regenerated and compared,
#               and every workspace package's tests.
#   --pixelbook  Pixelbook's graph files against the state catalogs they name, and the catalogs'
#               manifests against their sources (`Web/pixelbook/scripts/graphs.ts`), so renaming
#               a state can't break a graph.
#   --hook      Refuse to run while the checked paths have unstaged or untracked changes: the
#               checks see the working tree, so it has to match what's being committed.
# Every step runs even after one fails, so one failure doesn't hide another.
set -u

swift=false
services=false
pixelbook=false
hook=false
for arg in "$@"; do
  case "$arg" in
    --swift) swift=true ;;
    --services) services=true ;;
    --pixelbook) pixelbook=true ;;
    --hook) hook=true ;;
    *)
      echo "usage: scripts/check [--hook] [--swift] [--services] [--pixelbook]" >&2
      exit 2
      ;;
  esac
done
if ! $swift && ! $services && ! $pixelbook; then
  swift=true
  services=true
  pixelbook=true
fi

cd "$(dirname "$0")/.."

# As on GitHub: our targets treat warnings as errors (`LilPackage/Package.swift`).
export CI=1
# Builds of their own, so they neither invalidate nor wait on Xcode's and everyday `swift test`'s.
# CI keeps them outside its checkout, which it cleans (`LIL_CHECK_SCRATCH`, `swift-check.yml`).
scratch="${LIL_CHECK_SCRATCH:-$PWD/.build-check}"

status=0
step() {
  "$@" || status=1
}

swift_paths="LilPackage Apps Tools Lil.xcworkspace .swift-format scripts Services/api/health-catalog.json"
# The TypeScript workspace, with its root config, plus what the generated client depends on.
services_paths="Services Web Apps/LilHealth/LilHealth-Info.plist Apps/LilHealth/LilHealthiOS-Info.plist package.json pnpm-workspace.yaml pnpm-lock.yaml .node-version vite.config.ts tsconfig.json tsconfig.base.json Tools LilPackage/Sources/Lil/LilAPIGenerated scripts"
pixelbook_paths="LilPackage/Tests/*/*/Catalogs Web/pixelbook/graphs Web/pixelbook/src/lib/Graph.ts Web/pixelbook/scripts"
paths=""
$swift && paths="$paths $swift_paths"
$services && paths="$paths $services_paths"
$pixelbook && paths="$paths $pixelbook_paths"
if $hook; then
  # shellcheck disable=SC2086
  dirty=$(git status --porcelain --untracked-files=all -- $paths lefthook.yml |
    grep -v '^[MADRC] ' || true)
  if [ -n "$dirty" ]; then
    echo "error: these have changes that aren't staged, so the checks wouldn't see what's being" >&2
    echo "committed. Stage them, or set them aside with 'git stash --keep-index -u':" >&2
    echo "$dirty" >&2
    exit 1
  fi
fi

if $swift; then
  step scripts/format --lint --swift
  step scripts/test-snapshot-sheet
  step sh -c 'cd LilPackage && swift test --quiet --scratch-path "$1/package"' _ "$scratch"
  # Unsigned: this only checks that the apps build.
  step xcodebuild -workspace Lil.xcworkspace -scheme LilMessages -destination 'platform=macOS' \
    -derivedDataPath "$scratch/DerivedData" -skipMacroValidation \
    -onlyUsePackageVersionsFromResolvedFile CODE_SIGNING_ALLOWED=NO build -quiet
  step xcodebuild -workspace Lil.xcworkspace -scheme LilHealth -destination 'platform=macOS' \
    -derivedDataPath "$scratch/DerivedData" -skipMacroValidation \
    -onlyUsePackageVersionsFromResolvedFile CODE_SIGNING_ALLOWED=NO build -quiet
  step xcodebuild -workspace Lil.xcworkspace -scheme LilHealthiOS \
    -destination 'generic/platform=iOS Simulator' -derivedDataPath "$scratch/DerivedData" \
    -skipMacroValidation -onlyUsePackageVersionsFromResolvedFile CODE_SIGNING_ALLOWED=NO \
    build -quiet
  # The iPhone's snapshot tests only compile here: they run in the simulator, after merges
  # (`scripts/snapshot --iphone`, 851-2953).
  step xcodebuild -workspace Lil.xcworkspace -scheme HealthPhoneSnapshotTests \
    -destination 'generic/platform=iOS Simulator' -derivedDataPath "$scratch/DerivedData" \
    -skipMacroValidation -onlyUsePackageVersionsFromResolvedFile CODE_SIGNING_ALLOWED=NO \
    build-for-testing -quiet
fi

if $services; then
  step scripts/format --lint --services
  step scripts/generate-api-client --check
  step vp run -r test
fi

if $pixelbook; then
  step node Web/pixelbook/scripts/graphs.ts
fi

exit "$status"
