#!/bin/sh
# Waits until a deployed API reports the expected version at /v1/status.
# Usage: scripts/check-deploy <base-url> <version>
# Gives up after about 2 minutes, because new custom domains and edge caches take a moment.
set -eu

url="$1/v1/status"
expected="$2"
deadline=$(($(date +%s) + 120))
body=""

while [ "$(date +%s)" -lt "$deadline" ]; do
  body=$(curl -sS -m 5 "$url" 2>/dev/null || true)
  case "$body" in
    *"\"version\":\"$expected\""*)
      echo "$url: $body"
      exit 0
      ;;
  esac
  sleep 5
done

echo "error: $url didn't report version $expected. Last response: ${body:-none}" >&2
exit 1
