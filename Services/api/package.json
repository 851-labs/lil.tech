{
  "name": "@lil/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "dev": "LIL_ENVIRONMENT=local LIL_VERSION=dev alchemy dev",
    "deploy": "LIL_ENVIRONMENT=preview LIL_VERSION=$(git describe --always --dirty --exclude '*') alchemy deploy",
    "deploy:staging": "LIL_ENVIRONMENT=staging LIL_VERSION=$(git describe --always --dirty --exclude '*') alchemy deploy --stage staging",
    "deploy:prod": "LIL_ENVIRONMENT=prod LIL_VERSION=$(git describe --always --dirty --exclude '*') alchemy deploy --stage prod",
    "openapi": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "mcp-tools": "node scripts/mcp-tools.ts",
    "mcp-tools:check": "node scripts/mcp-tools.ts --check",
    "migrations": "node scripts/migrations.ts",
    "migrations:check": "node scripts/migrations.ts --check",
    "bench": "node scripts/bench-sync.ts"
  },
  "dependencies": {
    "@effect/sql-d1": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
