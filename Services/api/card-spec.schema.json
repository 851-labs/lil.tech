                      },
                      "minutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 240
                      }
                    },
                    "required": [
                      "kind",
                      "minutes"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
