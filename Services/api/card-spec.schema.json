            "ear",
            "heart.fill",
            "pills.fill",
            "brain.head.profile",
            "figure.walk.motion",
            "carrot.fill",
            "lungs.fill",
            "bed.double.fill",
            "list.bullet.clipboard",
            "waveform.path.ecg",
            "plus",
            "heart.text.square.fill",
            "bolt.heart.fill",
            "waveform",
            "drop.fill",
            "thermometer.medium",
            "scalemass.fill",
            "ruler.fill",
            "eye.fill",
            "hand.raised.fill",
            "brain",
            "cross.case.fill",
            "figure.walk",
            "figure.run",
            "figure.stairs",
            "figure.pool.swim",
            "figure.outdoor.cycle",
            "bicycle",
            "figure.strengthtraining.traditional",
            "figure.mind.and.body",
            "figure.cooldown",
            "bolt.fill",
            "timer",
            "stopwatch.fill",
            "moon.fill",
            "moon.zzz.fill",
            "zzz",
            "sun.max.fill",
            "sunrise.fill",
            "sunset.fill",
            "clock.fill",
            "alarm.fill",
            "fork.knife",
            "cup.and.saucer.fill",
            "waterbottle.fill",
            "leaf.fill",
            "chart.line.uptrend.xyaxis",
            "chart.bar.fill",
            "gauge.with.dots.needle.50percent",
            "star.fill",
            "target",
            "flag.fill"
