          "enum": [
            "bars",
            "ranges",
            "dots",
            "line"
          ]
        },
        "goal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "style",
        "goal"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "display",
    "series",
    "formulas",
    "bucket",
    "range",
    "chart"
  ],
  "additionalProperties": false
}
