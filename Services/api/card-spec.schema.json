        "color": {
          "type": "string",
          "enum": [
            "red",
            "orange",
            "yellow",
            "green",
            "mint",
            "teal",
            "cyan",
            "blue",
            "indigo",
            "purple",
            "pink",
            "brown",
            "gray"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "kg",
                "lb",
                "st",
                "cm",
                "m",
                "km",
                "in",
                "ft",
                "yd",
                "mi",
                "degC",
                "degF",
                "km/hr",
                "mi/hr",
                "m/s",
                "mL",
                "L",
                "fl_oz_us",
                "kcal",
                "kJ"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "symbol",
        "color",
        "unit"
      ],
      "additionalProperties": false
