            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "pattern": "^[a-z][a-z0-9]{0,15}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "difference"
                ]
              },
              "of": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^[a-z][a-z0-9]{0,15}$"
