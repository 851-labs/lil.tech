          },
          "required": [
            "device",
            "pairedWithWatch",
            "lastReported",
            "statisticsSource"
          ],
          "additionalProperties": true
        }
      }
    },
    "annotations": {
      "title": "Health Sync Status",
      "readOnlyHint": true,
