[
  {
    "name": "summary",
    "description": "Start here. An overview of the person's Apple Health data, as lil health's Summary shows it: for each metric they pinned (or everyday defaults: steps, heart rate, active energy, walking + running distance, resting heart rate, weight), the latest sample and, for types that add up, today's and the last 7 days' totals; plus the workouts of the last 7 days (today and the 6 days before).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "An IANA time zone, e.g. Europe/London, for days and local times. Defaults to UTC on the remote server and to the Mac's time zone locally. Every output says which it used."
        }
      },
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "The IANA time zone of the output's days and local times."
        },
        "date": {
          "type": "string",
          "description": "Today."
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether `metrics` are the ones the person pinned to Summary in lil health; if not, they're everyday defaults."
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthSummaryMetric"
          },
          "description": "The metrics, in the order Summary shows them."
        },
        "workouts": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "duration": {
              "type": "number",
              "description": "Seconds of activity, excluding pauses."
            }
          },
          "required": [
            "count",
            "duration"
          ],
          "additionalProperties": true,
          "description": "Workouts that started today (by now) or in the 6 days before."
        }
      },
      "required": [
        "timeZone",
        "date",
        "pinned",
        "metrics",
        "workouts"
      ],
      "additionalProperties": true,
      "$defs": {
        "HealthSummaryMetric": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "A HealthKit type identifier, e.g. HKQuantityTypeIdentifierStepCount or HKCategoryTypeIdentifierSleepAnalysis. list_types and search return them."
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The HealthKit unit of the values, e.g. count, kcal or count/min. Null for category types."
            },
            "latest": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "description": "A time in the output's `timeZone`, to the second, with its UTC offset, e.g. 2026-10-20T08:15:00+01:00."
                    },
                    "end": {
                      "type": "string",
                      "description": "A time in the output's `timeZone`, to the second, with its UTC offset, e.g. 2026-10-20T08:15:00+01:00."
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "A quantity's value, in `unit`. Null for category types."
                    },
                    "categoryValue": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "A category sample's HealthKit value (HKCategoryValue…). Null for quantities."
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "value",
                    "categoryValue"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ],
              "description": "The most recent sample that has started, or null if there's none."
            },
            "today": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "For types that add up (steps, energy, distance): today's total, as Health counts it. Null for other types, or with nothing recorded today."
            },
            "last7Days": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "For types that add up: the total over today and the 6 days before. Null for other types, or with nothing recorded in those days."
            }
          },
          "required": [
            "type",
            "unit",
            "latest",
            "today",
            "last7Days"
          ],
          "additionalProperties": true
        }
      }
    },
    "annotations": {
      "title": "Health Summary",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "title": "Health Summary"
  },
  {
    "name": "list_types",
    "description": "Lists the kinds of Health data the person has (only types with data), with each type's identifier, name, category, unit and date range. Use the identifiers with metric and samples.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "An IANA time zone, e.g. Europe/London, for days and local times. Defaults to UTC on the remote server and to the Mac's time zone locally. Every output says which it used."
        }
      },
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "The IANA time zone of the output's days and local times."
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthTypeInfo"
          },
          "description": "Every type with data, by category, then name."
        }
      },
      "required": [
        "timeZone",
        "types"
      ],
      "additionalProperties": true,
      "$defs": {
        "HealthTypeInfo": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "A HealthKit type identifier, e.g. HKQuantityTypeIdentifierStepCount or HKCategoryTypeIdentifierSleepAnalysis. list_types and search return them."
            },
            "name": {
              "type": "string",
              "description": "The name Health shows, e.g. Steps."
            },
            "category": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The Browse category, e.g. Activity or Heart. Null for characteristics."
            },
            "kind": {
              "type": "string",
              "description": "What kind of data it is: quantity, category, workout, medication, electrocardiogram…"
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A quantity type's HealthKit unit, e.g. count/min. Null for other kinds."
            },
            "cumulative": {
              "type": "boolean",
              "description": "Whether values add up (steps, energy), so metric's default statistic is a sum rather than an average."
            },
            "first": {
              "type": "string",
              "description": "When the earliest record starts."
            },
            "last": {
              "type": "string",
              "description": "When the latest record starts."
            }
          },
          "required": [
            "type",
            "name",
            "category",
            "kind",
            "unit",
            "cumulative",
            "first",
            "last"
          ],
          "additionalProperties": true
        }
      }
    },
    "annotations": {
      "title": "List Health Data Types",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "title": "List Health Data Types"
  },
  {
    "name": "metric",
    "description": "A quantity type's statistic over a period, overall and per hour, day, week or month, computed as Health does: totals of types that add up come from the iPhone's own statistics (so iPhone and Watch steps aren't counted twice), and averages follow the type's style (heart rate is weighted by time). Prefer this to samples.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "A HealthKit type identifier, e.g. HKQuantityTypeIdentifierStepCount or HKCategoryTypeIdentifierSleepAnalysis. list_types and search return them."
        },
        "range": {
          "type": "string",
          "enum": [
            "D",
            "W",
            "M",
            "6M",
            "Y"
          ],
          "description": "The period, ending on `date`: D is that day, in hours; W the 7 days ending that day, in days; M the 30 days ending that day, in days; 6M the 26 weeks ending that day, in 7-day weeks; Y the 12 calendar months ending with that day's month, in months (the last one ends with `date`)."
        },
        "statistic": {
          "type": "string",
          "enum": [
            "sum",
            "average",
            "minimum",
            "maximum"
          ],
          "description": "Defaults to sum for types that add up (steps, energy), and average for others."
        },
        "date": {
          "type": "string"
        },
        "timeZone": {
          "type": "string",
          "description": "An IANA time zone, e.g. Europe/London, for days and local times. Defaults to UTC on the remote server and to the Mac's time zone locally. Every output says which it used."
        }
      },
      "required": [
        "type",
        "range"
      ],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "The IANA time zone of the output's days and local times."
        },
        "range": {
          "type": "string",
          "description": "The range asked for: D, W, M, 6M or Y."
        },
        "start": {
          "type": "string",
          "description": "When the period starts."
        },
        "end": {
          "type": "string",
          "description": "When the period ends (exclusive)."
        },
        "type": {
          "type": "string",
          "description": "A HealthKit type identifier, e.g. HKQuantityTypeIdentifierStepCount or HKCategoryTypeIdentifierSleepAnalysis. list_types and search return them."
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The values' HealthKit unit."
        },
        "statistic": {
          "type": "string",
          "description": "The statistic: sum, average, minimum or maximum."
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The statistic over the whole period, or null without data."
        },
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthMetricBucket"
          },
          "description": "The period's hours, days, weeks or months, oldest first."
        }
      },
      "required": [
        "timeZone",
        "range",
        "start",
        "end",
        "type",
        "unit",
        "statistic",
        "value",
        "buckets"
      ],
      "additionalProperties": true,
      "$defs": {
        "HealthMetricBucket": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "description": "A time in the output's `timeZone`, to the second, with its UTC offset, e.g. 2026-10-20T08:15:00+01:00."
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The statistic over the bucket, in `unit`, or null without data."
            }
          },
          "required": [
            "start",
            "value"
          ],
          "additionalProperties": true
        }
      }
    },
    "annotations": {
      "title": "Health Metric",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "title": "Health Metric"
  },
  {
    "name": "samples",
    "description": "Individual samples of a quantity or category type in a period, newest first, a page at a time. A type can have many thousands of samples a day: use metric for totals and trends, and this only to look at particular readings.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "A HealthKit type identifier, e.g. HKQuantityTypeIdentifierStepCount or HKCategoryTypeIdentifierSleepAnalysis. list_types and search return them."
        },
        "range": {
          "type": "string",
          "enum": [
            "D",
            "W",
            "M",
            "6M",
            "Y"
          ],
          "description": "The period, ending on `date`: D is that day, in hours; W the 7 days ending that day, in days; M the 30 days ending that day, in days; 6M the 26 weeks ending that day, in 7-day weeks; Y the 12 calendar months ending with that day's month, in months (the last one ends with `date`)."
        },
        "date": {
          "type": "string"
        },
        "timeZone": {
          "type": "string",
          "description": "An IANA time zone, e.g. Europe/London, for days and local times. Defaults to UTC on the remote server and to the Mac's time zone locally. Every output says which it used."
        },
        "cursor": {
          "type": "string",
          "description": "The previous page's nextCursor."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Samples per page, at most 500. Defaults to 100."
        }
      },
      "required": [
        "type",
        "range"
      ],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "The IANA time zone of the output's days and local times."
        },
        "range": {
          "type": "string",
          "description": "The range asked for: D, W, M, 6M or Y."
        },
        "start": {
          "type": "string",
          "description": "When the period starts."
        },
        "end": {
          "type": "string",
          "description": "When the period ends (exclusive)."
        },
        "type": {
          "type": "string",
          "description": "A HealthKit type identifier, e.g. HKQuantityTypeIdentifierStepCount or HKCategoryTypeIdentifierSleepAnalysis. list_types and search return them."
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthSampleItem"
          },
          "description": "Samples that start in the period, newest first."
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pass it as `cursor` for the next, older page; null on the last page."
        }
      },
      "required": [
        "timeZone",
        "range",
        "start",
        "end",
        "type",
        "samples",
        "nextCursor"
      ],
      "additionalProperties": true,
      "$defs": {
        "HealthSampleItem": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "HealthKit's UUID for the sample."
            },
            "start": {
              "type": "string",
              "description": "A time in the output's `timeZone`, to the second, with its UTC offset, e.g. 2026-10-20T08:15:00+01:00."
            },
            "end": {
              "type": "string",
              "description": "A time in the output's `timeZone`, to the second, with its UTC offset, e.g. 2026-10-20T08:15:00+01:00."
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A quantity's value, in `unit`. Null for category types."
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "categoryValue": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ],
              "description": "A category sample's HealthKit value (HKCategoryValue…). Null for quantities."
            },
            "source": {
              "type": "string",
              "description": "The app or device that recorded it, e.g. an Apple Watch's name."
            }
          },
          "required": [
            "id",
            "start",
            "end",
            "value",
            "unit",
            "categoryValue",
            "source"
          ],
          "additionalProperties": true
        }
      }
    },
    "annotations": {
      "title": "Health Samples",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "title": "Health Samples"
  },
  {
    "name": "workouts",
    "description": "Workouts that started in a period, newest first, with their activity, duration, energy, distance and average heart rate, and the period's count and total time.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "range": {
          "type": "string",
          "enum": [
            "D",
            "W",
            "M",
            "6M",
            "Y"
          ],
          "description": "The period, ending on `date`: D is that day, in hours; W the 7 days ending that day, in days; M the 30 days ending that day, in days; 6M the 26 weeks ending that day, in 7-day weeks; Y the 12 calendar months ending with that day's month, in months (the last one ends with `date`)."
        },
        "date": {
          "type": "string"
        },
        "timeZone": {
          "type": "string",
          "description": "An IANA time zone, e.g. Europe/London, for days and local times. Defaults to UTC on the remote server and to the Mac's time zone locally. Every output says which it used."
        }
      },
      "required": [
        "range"
      ],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "The IANA time zone of the output's days and local times."
        },
        "range": {
          "type": "string",
          "description": "The range asked for: D, W, M, 6M or Y."
        },
        "start": {
          "type": "string",
          "description": "When the period starts."
        },
        "end": {
          "type": "string",
          "description": "When the period ends (exclusive)."
