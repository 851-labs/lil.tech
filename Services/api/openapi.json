{
  "openapi": "3.1.0",
  "info": {
    "title": "lil API",
    "version": "0.0.1"
  },
  "paths": {
    "/v1/status": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "status",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Which deployment is serving the API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "authRefresh",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "An access token for API requests and a refresh token to get the next pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "description": "InvalidRefreshToken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidRefreshToken"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "authSignOut",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "operationId": "me",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "lil/api/auth/Me",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/changes": {
      "get": {
        "tags": [
          "sync"
        ],
        "operationId": "syncChanges",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            },
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 1000
            },
            "required": false
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the change log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "410": {
            "description": "ChangesCompacted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesCompacted"
                }
              }
            }
          },
          "503": {
            "description": "UserStoreUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserStoreUnavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Unauthorized": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ]
      },
      "UserStoreUnavailable": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "UserStoreUnavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ]
      },
      "ChangesCompacted": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ChangesCompacted"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "reason"
        ]
      },
      "ChangesPage": {
        "type": "object",
        "properties": {
          "epoch": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "next": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "head": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "epoch",
          "changes",
          "next",
          "head",
          "hasMore"
        ],
        "description": "A page of the change log"
      },
      "Change": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "entity": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "row": {
            "type": "object"
          },
          "at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "seq",
          "entity",
          "id",
          "op",
          "at"
        ],
        "description": "One entry of the change log"
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "identities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeIdentity"
            }
          }
        },
        "required": [
          "id",
          "displayName",
          "identities"
        ]
      },
      "MeIdentity": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "apple",
              "google"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "provider",
          "email"
        ]
      },
      "InvalidRefreshToken": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidRefreshToken"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "prod",
              "staging",
              "preview",
              "local"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "environment",
          "version"
        ]
      },
      "HealthSample": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "startDate": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "endDate": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "categoryValue": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceName": {
            "type": "string"
          },
          "sourceBundleId": {
            "type": "string"
          },
          "sourceRevision": {},
          "device": {},
          "metadata": {}
        },
        "required": [
          "id",
          "type",
          "startDate",
          "endDate",
          "sourceName",
          "sourceBundleId"
        ],
        "additionalProperties": true
      },
      "HealthCorrelation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "startDate": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "endDate": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sourceName": {
            "type": "string"
          },
          "sourceBundleId": {
            "type": "string"
          },
          "sourceRevision": {},
          "device": {},
          "metadata": {}
        },
        "required": [
          "id",
          "type",
          "startDate",
          "endDate",
          "sourceName",
          "sourceBundleId"
        ],
        "additionalProperties": true
      },
      "HealthCharacteristic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "id",
          "value"
        ],
        "additionalProperties": true
      },
      "HealthActivitySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "activeEnergyBurned": {
            "type": [
              "number",
              "null"
            ]
          },
          "activeEnergyBurnedGoal": {
            "type": [
              "number",
              "null"
            ]
          },
          "appleMoveTime": {
            "type": [
              "number",
              "null"
            ]
          },
          "appleMoveTimeGoal": {
            "type": [
              "number",
              "null"
            ]
          },
          "appleExerciseTime": {
            "type": [
              "number",
              "null"
            ]
          },
          "appleExerciseTimeGoal": {
            "type": [
              "number",
              "null"
            ]
          },
          "appleStandHours": {
            "type": [
              "number",
              "null"
            ]
          },
          "appleStandHoursGoal": {
            "type": [
              "number",
              "null"
            ]
          },
          "activityMoveMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "paused": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "auth"
    },
    {
      "name": "me"
    },
    {
      "name": "sync"
    }
  ]
}
